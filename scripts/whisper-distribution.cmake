# Initial cache shared by native application and accelerator builds. These
# artifacts move to other machines: runner ISA and build paths are not a contract.
set(GGML_NATIVE OFF CACHE BOOL "Portable CPU code" FORCE)
foreach(feature SSE42 AVX AVX2 AVX_VNNI BMI2 FMA F16C AVX512 AVX512_VBMI AVX512_VNNI AVX512_BF16 AMX_TILE AMX_INT8 AMX_BF16)
    set(GGML_${feature} OFF CACHE BOOL "Use the distribution CPU baseline" FORCE)
endforeach()
set(GGML_CPU_ARM_ARCH "armv8-a" CACHE STRING "AArch64 baseline" FORCE)
set(GGML_CPU_ALL_VARIANTS OFF CACHE BOOL "One explicit baseline" FORCE)
set(GGML_BACKEND_DL OFF CACHE BOOL "Link selected backends directly" FORCE)
set(GGML_LLAMAFILE OFF CACHE BOOL "Avoid optional host-tuned CPU kernels" FORCE)
set(GGML_BLAS OFF CACHE BOOL "No incidental package-manager BLAS dependency" FORCE)
set(GGML_OPENMP OFF CACHE BOOL "No incidental OpenMP runtime dependency" FORCE)
set(GGML_METAL_EMBED_LIBRARY ON CACHE BOOL "No build-directory Metal shader dependency" FORCE)
set(CMAKE_BUILD_WITH_INSTALL_RPATH ON CACHE BOOL "Use relocated library paths in staged binaries" FORCE)
if(CMAKE_HOST_APPLE)
    set(CMAKE_INSTALL_RPATH "@loader_path" CACHE STRING "Sibling runtime libraries" FORCE)
    set(CMAKE_INSTALL_NAME_DIR "@rpath" CACHE STRING "Relocatable Mach-O library IDs" FORCE)
    set(CMAKE_BUILD_WITH_INSTALL_NAME_DIR ON CACHE BOOL "No build-directory library IDs" FORCE)
elseif(CMAKE_HOST_UNIX)
    set(CMAKE_INSTALL_RPATH "$ORIGIN" CACHE STRING "Sibling runtime libraries" FORCE)
    set(CMAKE_BUILD_RPATH_USE_ORIGIN ON CACHE BOOL "Relative ELF build paths" FORCE)
endif()
