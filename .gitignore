node_modules/
dist/
src-tauri/target/
src-tauri/gen/schemas/
.DS_Store
*.log

# Local configuration and credentials must never be committed
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
credentials.json
credentials.local.json

# Downloaded runtime binaries are intentionally not stored in source control
src-tauri/runtime/windows/*.exe
src-tauri/runtime/windows/cpu/*
src-tauri/runtime/windows/cuda/*
src-tauri/runtime/macos/*
src-tauri/runtime/linux/*
!src-tauri/runtime/**/.gitkeep

# Developer-only runtime downloads are kept outside the bundled runtime tree.
# Ignore binaries while retaining directory placeholders.
src-tauri/runtime-dev/**
!src-tauri/runtime-dev/
!src-tauri/runtime-dev/**/
!src-tauri/runtime-dev/**/.gitkeep

skills
