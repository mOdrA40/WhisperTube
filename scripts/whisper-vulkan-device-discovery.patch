--- a/examples/cli/cli.cpp
+++ b/examples/cli/cli.cpp
@@ -4,2 +4,3 @@
 #include "whisper.h"
+#include "ggml-backend.h"
 #include "grammar-parser.h"
@@ -975,4 +976,21 @@
     SetConsoleOutputCP(CP_UTF8);
