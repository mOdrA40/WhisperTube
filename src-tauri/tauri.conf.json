{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "WhisperTube",
  "version": "0.1.1",
  "identifier": "app.whispertube.local",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "WhisperTube",
        "width": 1280,
        "height": 820,
        "minWidth": 920,
        "minHeight": 650,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "label": "main"
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self' asset:",
        "connect-src": "ipc: http://ipc.localhost",
        "img-src": "'self' asset: http://asset.localhost data: https:",
        "style-src": "'self' 'unsafe-inline'"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDMxRjkzNTYwRTYzNDI3MTIKUldRU0p6VG1ZRFg1TWNrS3Q1aGh4V2U5cVJiNTRKR0dDY0kwaGdsVS9wUGd4c1ZmTnFySndhcmoK",
      "endpoints": [
        "https://github.com/mOdrA40/WhisperTube/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": false,
    "targets": "all",
    "resources": [
      "runtime/**/*",
      "../LICENSE",
      "../THIRD_PARTY_NOTICES.md"
    ],
    "macOS": {
      "signingIdentity": "-"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ]
  }
}
